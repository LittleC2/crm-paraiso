	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "prisma generate",
		"lint": "eslint .",
		"format": "prettier --write .",
